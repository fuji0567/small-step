# `production` では Supabase認証・PostgreSQL・（有効にする場合は）HTTPSの保護者アーカイブが必須です。
APP_ENV=development
DATABASE_URL=sqlite:///./data/otayori.db
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BOOTSTRAP_ADMIN_EMAILS=
# 新しい園を作るときの、成長記録の既定配信時刻です。作成後は先生画面の「園の設定」で園ごとに変更できます。
DIGEST_TIME=17:00
TIMEZONE=Asia/Tokyo

# LINE Developers Console > Messaging API channel settings
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_API_TIMEOUT_SECONDS=10
# LINE配信ワーカーの確認間隔（秒）。失敗した通知は自動再送しません。
LINE_WORKER_POLL_SECONDS=15


# Notion internal connection. Keep the installation token out of Git.
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_API_TIMEOUT_SECONDS=10

# Local edge audio + MCP server. Raw audio remains in EDGE_AUDIO_INBOX_DIR
# and is deleted after processing by default.
EDGE_AUDIO_INBOX_DIR=./data/edge-audio-inbox
EDGE_AUDIO_MAX_FILE_BYTES=25000000
EDGE_AUDIO_DELETE_AFTER_PROCESSING=true
EDGE_AUDIO_LANGUAGE=ja
EDGE_AUDIO_MODEL=small
EDGE_AUDIO_DEVICE=cpu
EDGE_AUDIO_COMPUTE_TYPE=int8
# Polling watcher settings. Files newer than this age are treated as still recording.
EDGE_AUDIO_WATCH_POLL_SECONDS=2
EDGE_AUDIO_WATCH_MIN_AGE_SECONDS=2
# Cloud upload failures leave audio on the recording terminal and retry with
# exponential waiting. The server never receives the original filename.
EDGE_AUDIO_RETRY_INITIAL_SECONDS=10
EDGE_AUDIO_RETRY_MAX_SECONDS=300
# Mac microphone recorder settings. Use `scripts/record_edge_audio.py --list-devices`
# to find the correct input if :0 is not your microphone.
EDGE_AUDIO_RECORD_CHUNK_SECONDS=30
EDGE_AUDIO_INPUT_DEVICE=:0
# `local` keeps transcription and LLM processing on this machine. Change this
# only on a recording terminal after the VRT API is ready to receive raw audio.
EDGE_AUDIO_PROCESSING_MODE=local

# Sakura VRT server mode. This is disabled by default because it accepts raw
# audio uploads. The API and GPU worker must share this private directory.
CLOUD_AUDIO_ENABLED=false
CLOUD_AUDIO_JOB_DIR=./data/cloud-audio-jobs
CLOUD_AUDIO_JOB_RETENTION_MINUTES=15
# A stopped worker's job can be safely reclaimed after this many minutes.
CLOUD_AUDIO_PROCESSING_TIMEOUT_MINUTES=10
CLOUD_AUDIO_WORKER_POLL_SECONDS=2
# VRT readiness requires both LLM_BASE_URL and LLM_MODEL when cloud audio is enabled.

# Local anonymous speaker diarization. The Hugging Face access token is only
# used to download the model after accepting its user conditions; never commit it.
SPEAKER_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
SPEAKER_DIARIZATION_TOKEN=
SPEAKER_DIARIZATION_DEVICE=cpu
# When the first pass detects only one speaker, retry once with a temporary
# local audio normalization pass. The original recording is never modified.
SPEAKER_DIARIZATION_LOW_VOLUME_RETRY=true

# The LLM must run locally by default, for example vLLM or Ollama on the same
# edge PC / Sakura high-firepower VM. Set LLM_ALLOW_EXTERNAL=true only for a
# trusted remote endpoint after reviewing the privacy impact.
LLM_BACKEND=ollama
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=
LLM_ALLOW_EXTERNAL=false
LLM_TIMEOUT_SECONDS=60

# Dedicated API key issued by POST /api/v1/edge-devices. Do not commit it.
EDGE_API_URL=http://127.0.0.1:8000
EDGE_API_KEY=
EDGE_API_TIMEOUT_SECONDS=15
# The watcher sends an audio-free device heartbeat at this interval.
EDGE_DEVICE_HEARTBEAT_INTERVAL_SECONDS=60

# Guardian delivery archive. Keep disabled until a private HTTPS URL and the
# guardian-link operating procedure have been reviewed.
GUARDIAN_ARCHIVE_ENABLED=false
GUARDIAN_ARCHIVE_BASE_URL=http://127.0.0.1:8000
GUARDIAN_ARCHIVE_LINK_TTL_HOURS=168
