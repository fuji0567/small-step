# `production` では Supabase認証・PostgreSQL・（有効にする場合は）HTTPSの保護者アーカイブが必須です。
APP_ENV=development
DATABASE_URL=sqlite:///./data/otayori.db
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_BOOTSTRAP_ADMIN_EMAILS=
# 先生管理画面から招待する場合だけ有効化します。秘密キーはサーバー専用です。
# VITE_ / PUBLIC_ を付けず、チャット・Git・ブラウザへ渡さないでください。
TEACHER_INVITATIONS_ENABLED=false
SUPABASE_SECRET_KEY=
# SupabaseのRedirect URLsにも同じURLを許可してください。
TEACHER_INVITATION_REDIRECT_URL=https://app.otayori-ai.com/teacher/
# 新しい園を作るときの、成長記録の既定配信時刻です。作成後は先生画面の「園の設定」で園ごとに変更できます。
DIGEST_TIME=17:00
TIMEZONE=Asia/Tokyo

# LINE Developers Console > Messaging API channel settings
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_API_TIMEOUT_SECONDS=10
# LINE配信ワーカーの確認間隔（秒）。失敗した通知は自動再送しません。
LINE_WORKER_POLL_SECONDS=15


# Notion internal connection. Keep the installation token out of Git.
NOTION_API_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_API_TIMEOUT_SECONDS=10

# Local edge audio + MCP server. Raw audio remains in EDGE_AUDIO_INBOX_DIR
# and is deleted after processing by default.
EDGE_AUDIO_INBOX_DIR=./data/edge-audio-inbox
EDGE_AUDIO_MAX_FILE_BYTES=25000000
EDGE_AUDIO_DELETE_AFTER_PROCESSING=true
EDGE_AUDIO_LANGUAGE=ja
EDGE_AUDIO_MODEL=small
EDGE_AUDIO_DEVICE=cpu
EDGE_AUDIO_COMPUTE_TYPE=int8
# Polling watcher settings. Files newer than this age are treated as still recording.
EDGE_AUDIO_WATCH_POLL_SECONDS=2
EDGE_AUDIO_WATCH_MIN_AGE_SECONDS=2
# Cloud upload failures leave audio on the recording terminal and retry with
# exponential waiting. The server never receives the original filename.
EDGE_AUDIO_RETRY_INITIAL_SECONDS=10
EDGE_AUDIO_RETRY_MAX_SECONDS=300
# Mac microphone recorder settings. Use `scripts/record_edge_audio.py --list-devices`
# to find the correct input if :0 is not your microphone.
EDGE_AUDIO_RECORD_CHUNK_SECONDS=30
EDGE_AUDIO_INPUT_DEVICE=:0
# `local` keeps transcription and LLM processing on this machine. Change this
# only on a recording terminal after the VRT API is ready to receive raw audio.
EDGE_AUDIO_PROCESSING_MODE=local

# Sakura VRT server mode. This is disabled by default because it accepts raw
# audio uploads. The API and GPU worker must share this private directory.
CLOUD_AUDIO_ENABLED=false
CLOUD_AUDIO_JOB_DIR=./data/cloud-audio-jobs
CLOUD_AUDIO_JOB_RETENTION_MINUTES=15
# A stopped worker's job can be safely reclaimed after this many minutes.
CLOUD_AUDIO_PROCESSING_TIMEOUT_MINUTES=10
CLOUD_AUDIO_WORKER_POLL_SECONDS=2
# 園内の共用スマートフォン向け `/rec/` 録音PWA。初期状態では無効です。
# 音声はDBへ入れず、ランダム名でこの短命ディレクトリへ保存します。
RECORDER_ENABLED=false
# プロコン用の入出力表示。園の試用モード＋録音ごとの同意＋本人ログインが必須です。
# 専用Fernetキーを生成し、APIとGPUワーカーに同じ値を設定。声紋用キーとは分けます。
RECORDER_DEMO_TRACE_ENABLED=false
RECORDER_DEMO_TRACE_ENCRYPTION_KEY=
# 録音で呼ぶ名前と出来事から園児候補を提案。確定には先生の確認が必須。
RECORDER_CHILD_MATCHING_ENABLED=false
RECORDER_SESSION_DIR=./data/edge-audio-inbox/recorder-sessions
RECORDER_RETENTION_HOURS=24
RECORDER_MAX_DURATION_MINUTES=60
RECORDER_MAX_DRAFT_SESSIONS=3
RECORDER_MAX_SEGMENT_BYTES=25000000
RECORDER_WORKER_HEARTBEAT_REQUIRED=true
# 1区間の処理が停止した場合の失敗判定。成功した区間は再処理しません。
RECORDER_PROCESSING_TIMEOUT_MINUTES=10
# Long-running workers write only their name and last-seen time to the database.
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_STALE_SECONDS=90
# VRT readiness requires both LLM_BASE_URL and LLM_MODEL when cloud audio is enabled.

# Local anonymous speaker diarization. The Hugging Face access token is only
# used to download the model after accepting its user conditions; never commit it.
SPEAKER_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
SPEAKER_DIARIZATION_TOKEN=
SPEAKER_DIARIZATION_DEVICE=cpu
# Cap segmentation and embedding batches when sharing a GPU with vLLM.
SPEAKER_DIARIZATION_BATCH_SIZE=4
# When the first pass detects only one speaker, retry once with a temporary
# local audio normalization pass. The original recording is never modified.
SPEAKER_DIARIZATION_LOW_VOLUME_RETRY=true

# Optional teacher voiceprint enrollment and one-to-one verification. Generate
# the encryption key once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep the key only in the VRT .env and a separate password manager backup.
VOICEPRINT_ENABLED=false
# 録音内の先生を照合して担当候補を表示。先生本人の追加同意も必要です。
RECORDER_VOICEPRINT_MATCHING_ENABLED=false
# 1対1本人確認とは別の基準。確率ではありません。実音声で評価してください。
RECORDER_VOICEPRINT_MATCH_THRESHOLD=0.85
RECORDER_VOICEPRINT_MATCH_MARGIN=0.1
VOICEPRINT_MODEL=pyannote/embedding
VOICEPRINT_ENCRYPTION_KEY=
VOICEPRINT_MATCH_THRESHOLD=0.75
VOICEPRINT_JOB_DIR=./data/cloud-audio-jobs/voiceprints
VOICEPRINT_JOB_RETENTION_MINUTES=15
VOICEPRINT_PROCESSING_TIMEOUT_MINUTES=10

# The LLM must run locally by default, for example vLLM or Ollama on the same
# edge PC / Sakura high-firepower VM. Set LLM_ALLOW_EXTERNAL=true only for a
# trusted remote endpoint after reviewing the privacy impact.
LLM_BACKEND=ollama
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=
LLM_MODEL=
LLM_ALLOW_EXTERNAL=false
LLM_TIMEOUT_SECONDS=60
# VRT Compose manages vLLM with these bounded defaults. Keep model caches on
# the mounted NVMe so rebuilding the container does not download them again.
VLLM_IMAGE=vllm/vllm-openai:v0.11.0
VLLM_MODEL_CACHE_DIR=/mnt/small-step-cache/huggingface
VLLM_COMPILE_CACHE_DIR=/mnt/small-step-cache/vllm
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=4

# Dedicated API key issued by POST /api/v1/edge-devices. Do not commit it.
EDGE_API_URL=http://127.0.0.1:8000
EDGE_API_KEY=
EDGE_API_TIMEOUT_SECONDS=15
# The watcher sends an audio-free device heartbeat at this interval.
EDGE_DEVICE_HEARTBEAT_INTERVAL_SECONDS=60

# Guardian delivery archive. Keep disabled until a private HTTPS URL and the
# guardian-link operating procedure have been reviewed.
GUARDIAN_ARCHIVE_ENABLED=false
GUARDIAN_ARCHIVE_BASE_URL=http://127.0.0.1:8000
GUARDIAN_ARCHIVE_LINK_TTL_HOURS=168

# Host directory for one-shot PostgreSQL application-data backups. These files
# contain personal data, so keep them private and copy them to encrypted off-site storage.
DATABASE_BACKUP_HOST_DIR=./data/database-backups
# The VRT backup worker creates a missing backup immediately, then once per day
# at this local time. Keep 0 until encrypted off-site copies are established.
DATABASE_BACKUP_DIR=./data/database-backups
DATABASE_BACKUP_TIME=03:00
DATABASE_BACKUP_WORKER_POLL_SECONDS=300
DATABASE_BACKUP_RETENTION_COUNT=0
# Encrypt each verified backup with an age public recipient, then upload it to
# private S3-compatible storage. Keep the matching age private identity offline.
DATABASE_BACKUP_OFFSITE_ENABLED=false
DATABASE_BACKUP_AGE_RECIPIENT=
DATABASE_BACKUP_S3_BUCKET=
DATABASE_BACKUP_S3_PREFIX=small-step/database
# Leave empty for AWS S3. Other providers must use an HTTPS endpoint.
DATABASE_BACKUP_S3_ENDPOINT_URL=
DATABASE_BACKUP_S3_REGION=ap-northeast-1
DATABASE_BACKUP_S3_SSE=AES256
DATABASE_BACKUP_S3_KMS_KEY_ID=
# Standard AWS SDK credentials, stored only in the VRT .env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Separate VRT monitor. Set the operator's LINE user ID only on the server;
# alerts include operational labels only, never child, audio, or connection data.
OPERATIONS_MONITOR_ENABLED=false
OPERATIONS_ALERT_LINE_USER_ID=
OPERATIONS_MONITOR_POLL_SECONDS=60
# Ignore brief deployment restarts, then repeat an unresolved alert every 6 hours.
OPERATIONS_ALERT_AFTER_SECONDS=180
OPERATIONS_ALERT_REPEAT_SECONDS=21600
OPERATIONS_CHECK_TIMEOUT_SECONDS=10
OPERATIONS_API_READINESS_URL=http://127.0.0.1:8000/api/v1/readiness
OPERATIONS_VLLM_HEALTH_URL=http://127.0.0.1:8001/health
OPERATIONS_BACKUP_DIR=./data/database-backups
OPERATIONS_BACKUP_MAX_AGE_HOURS=26
OPERATIONS_MIN_DISK_FREE_GB=10
OPERATIONS_DISK_PATHS=./data
OPERATIONS_MONITOR_STATE_PATH=./data/operations-monitor-state.json
