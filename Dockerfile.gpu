# GPU worker image for Sakura High Firepower VRT.
# The API keeps using the smaller Dockerfile; only this worker needs CUDA.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/var/lib/small-step/models/huggingface

RUN apt-get update \
    && apt-get install --yes --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml ./
COPY app ./app
COPY scripts ./scripts
RUN python3 -m pip install --break-system-packages --upgrade pip \
    && python3 -m pip install --break-system-packages '.[postgres,edge-audio,speaker-diarization]'

RUN useradd --create-home --uid 10001 appuser \
    && mkdir --parents /var/lib/small-step/cloud-audio-jobs /var/lib/small-step/models \
    && chown --recursive appuser:appuser /app /var/lib/small-step
USER appuser

CMD ["python3", "scripts/process_cloud_audio_jobs.py"]
